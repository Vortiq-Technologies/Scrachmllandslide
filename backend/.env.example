# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGO_URI=mongodb://localhost:27017/landslide_monitoring

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_signing_key_landslide_monitoring
JWT_EXPIRES_IN=7d

# Hardware Ingestion Security
DEVICE_INGEST_API_KEY=hw_ingest_secret_token_secure_gateway_2026

# Python AI/ML HTTP Microservice Integration
PYTHON_ML_SERVICE_URL=http://localhost:8000
PYTHON_ML_API_KEY=internal_ml_service_access_token_2026
ML_REQUEST_TIMEOUT_MS=5000

# Weather External Integration
WEATHER_API_URL=https://api.openweathermap.org/data/2.5
WEATHER_API_KEY=demo_weather_api_key

# GenAI Explanation Integration Layer (Human-in-the-loop)
GENAI_API_URL=https://generativelanguage.googleapis.com/v1beta
GENAI_API_KEY=demo_genai_api_key
GENAI_MODEL_NAME=gemini-1.5-flash

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
